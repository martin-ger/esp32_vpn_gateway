menu "Example Configuration"

    config STORE_HISTORY
        bool "Store command history in flash"
        default y
        help
            Linenoise line editing library provides functions to save and load
            command history. If this option is enabled, initalizes a FAT filesystem
            and uses it to store command history.

endmenu

menu "NAT Router Uplink"

    choice UPLINK_TYPE
        prompt "Uplink interface"
        default WIFI_STA_UPLINK
        config WIFI_STA_UPLINK
            bool "WiFi STA"
        config ETH_UPLINK
            bool "Ethernet (LAN8720)"
    endchoice

    config ETH_MDC_GPIO
        int "ETH MDC GPIO"
        default 23
        depends on ETH_UPLINK

    config ETH_MDIO_GPIO
        int "ETH MDIO GPIO"
        default 18
        depends on ETH_UPLINK

    config ETH_PHY_ADDR
        int "ETH PHY address"
        default 1
        depends on ETH_UPLINK

    config ETH_PHY_POWER_GPIO
        int "ETH PHY power GPIO (-1 for none)"
        default 16
        depends on ETH_UPLINK

    config ETH_RMII_CLK_OUTPUT_GPIO
        int "RMII clock output GPIO (-1 = input from PHY)"
        default -1
        depends on ETH_UPLINK
        help
            Set to the GPIO number on which the ESP32 should generate the 50 MHz
            RMII reference clock (e.g. GPIO 17 for the Olimex ESP32-POE-ISO).
            Leave at -1 when the PHY provides the clock (e.g. WT32-ETH01).

endmenu

menu "MQTT Broker"

    config MQTT_BROKER
        bool "Enable built-in MQTT broker"
        default y
        help
            Runs a local MQTT broker (espressif/mosquitto port) bound to
            the AP interface, e.g. mqtt://192.168.1.1:1883. Only LAN
            clients can reach it; no TLS transport in this port.
            Off at runtime until 'mqtt enable'. Adds ~60 KB flash;
            ~2 kB heap plus ~4 kB per connected client.

endmenu

menu "WireGuard Server"

    config WG_SERVER
        bool "Enable WireGuard server (inbound VPN)"
        default n
        select WIREGUARD_SERVER
        help
            Lets remote WireGuard clients connect to the router and reach the
            AP network (routed) and the uplink network and internet (NAT).
            Mutually exclusive with the WireGuard client uplink at runtime.
            Enabled for the ESP32 and ESP32-S3 variants (not C3/C5/C6). Selects the
            server API of the esp_wireguard component (WIREGUARD_SERVER), which
            raises WIREGUARD_MAX_PEERS to 8 (about 1 KB RAM per peer slot while a
            WireGuard interface exists).

endmenu
